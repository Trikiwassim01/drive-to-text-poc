# Copy to .env and adjust. Never commit .env.

# Optional but recommended: a Google API key restricted to the Drive API.
# Gives exact file sizes/types and reliable listing of public folders.
# Without it the app falls back to a best-effort keyless listing.
GOOGLE_API_KEY=

# Limits
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_BATCH=50
BATCH_CONCURRENCY=2

# Extraction tuning
OCR_DPI=200
PDF_MIN_CHARS_PER_PAGE=20
HTTP_TIMEOUT_S=30
